# Cloudflare Pages header rules.
#
# Cloudflare Web Analytics is enabled on this site. Its beacon lives on
# static.cloudflareinsights.com and must be allowed explicitly, otherwise
# the browser blocks it - which logs a CSP console error and drops the
# Best Practices score. Web Analytics is cookie-free and privacy-preserving.
#
# NOTE: this file format only supports # comments at the top level.
# A /* ... */ comment inside a rule block makes the whole deployment
# fail to build. Keep explanatory notes above the blocks.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' https://challenges.cloudflare.com; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src 'self' https://challenges.cloudflare.com https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com https://static.cloudflareinsights.com

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate